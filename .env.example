# Hosted PostgreSQL connection string (Neon, Vercel Postgres, Supabase, etc.)
# Use the DIRECT (non-pooled) connection string so `prisma db push` works.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Secret used to sign the session cookie. Use a long random string in production.
AUTH_SECRET="please-change-me"

# ---- 物販（Stripe 決済）----
# Stripe ダッシュボード → 開発者 → APIキー で取得。
STRIPE_SECRET_KEY="sk_test_xxx"
# Webhook 署名シークレット。Stripe → 開発者 → Webhook で /api/stripe/webhook を
# エンドポイント登録し、checkout.session.completed を購読して取得。
STRIPE_WEBHOOK_SECRET="whsec_xxx"
# 公開ページの絶対URL（Stripe Checkout の戻り先生成に使用）。本番は本番ドメイン。
NEXT_PUBLIC_APP_URL="http://localhost:3000"
