# Hosted PostgreSQL connection string (Neon, Vercel Postgres, Supabase, etc.)
# Use the DIRECT (non-pooled) connection string so `prisma db push` works.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Secret used to sign the session cookie. Use a long random string in production.
AUTH_SECRET="please-change-me"

# ---- 物販（Stripe 決済）----
# Stripe ダッシュボード → 開発者 → APIキー で取得。
STRIPE_SECRET_KEY="sk_test_xxx"
# Webhook 署名シークレット。Stripe → 開発者 → Webhook で /api/stripe/webhook を
# エンドポイント登録して取得。購読イベントは以下の4つを必ず有効化すること:
#   - checkout.session.completed          （決済完了 → 在庫確定・ポイント付与）
#   - checkout.session.expired            （カート放棄 → 予約在庫の解放）
#   - checkout.session.async_payment_succeeded （コンビニ/銀行振込の入金確定）
#   - checkout.session.async_payment_failed    （非同期決済の失敗 → 在庫解放）
# expired を購読しないと、未決済の予約在庫が解放されず在庫が目減りします。
STRIPE_WEBHOOK_SECRET="whsec_xxx"
# expired を購読しないと、未決済の予約在庫・利用ポイント・クーポン回数が解放されません。
# クーポン・ポイントの値引きは一回限りの Stripe クーポン（amount_off）として
# Checkout Session に載せるため、API キーに coupons の作成権限が必要です（標準キーで可）。
# 公開ページの絶対URL（Stripe Checkout の戻り先生成に使用）。本番は本番ドメイン。
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# AUTH_SECRET は管理画面のセッションに加え、販売ページの「会員確認」トークンの署名にも
# 使います。本番では必ず長いランダム文字列に置き換えてください。
