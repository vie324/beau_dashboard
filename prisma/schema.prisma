// Beau — salon reservation dashboard
// PostgreSQL via Prisma (hosted DB, works on Vercel/serverless).
// JSON-like fields are stored as TEXT (String). All tables soft delete via `deletedAt`.

generator client {
  provider      = "prisma-client-js"
  // "native" for local; "rhel-openssl-3.0.x" is Vercel's serverless runtime.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---- Brand-common tables (no shopId) ----

model Brand {
  id           Int           @id @default(autoincrement())
  name         String
  slug         String        @unique
  createdAt    DateTime      @default(now())
  deletedAt    DateTime?
  shops        Shop[]
  users        User[]
  bookingLinks BookingLink[]
}

model User {
  id           String    @id @default(cuid())
  brandId      Int?
  shopId       Int?
  email        String    @unique
  passwordHash String
  name         String
  // role: root | brand | shop | staff
  role         String    @default("shop")
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?
  brand        Brand?    @relation(fields: [brandId], references: [id])
}

// ---- Shop-scoped tables ----

model Shop {
  id                Int       @id @default(autoincrement())
  brandId           Int
  name              String
  uuid              String    @unique @default(cuid())
  sortNumber        Int       @default(0)
  address           String?
  phone             String?
  lineUrl           String?
  defaultBookingSlug String?
  // Business hours / break as "HH:mm" (null = use defaults)
  openTime          String?
  closeTime         String?
  breakStart        String?
  breakEnd          String?
  // JSON (TEXT): per day-of-week overrides keyed by "0"-"6" (Sun..Sat).
  // e.g. {"6":{"openTime":"08:30","closeTime":"19:30","breakStart":"12:30","breakEnd":"15:30"},"0":{"closed":true}}
  // Missing keys fall back to the defaults above.
  hoursByDow        String?
  // JSON (TEXT): specific-date overrides keyed by "YYYY-MM-DD".
  // e.g. {"2026-05-25":{"type":"closed","note":"祝日"},"2026-05-26":{"type":"morning"},"2026-05-27":{"type":"afternoon"}}
  // Priority: dateOverrides > hoursByDow > shop defaults.
  dateOverrides     String?
  // ---- 物販ストアフロント（公開販売ページ /shop/<storeSlug>） ----
  storeSlug         String?   @unique
  storeActive       Boolean   @default(false)
  storeTitle        String?
  storeDescription  String?
  // 配送送料（円）。0 で送料無料。
  shippingFee       Int       @default(0)
  // 送料無料になる税込購入額のしきい値（円）。0 で無効。
  freeShippingThreshold Int   @default(0)
  // ポイント: 購入小計（税抜）に対する付与率(%)。0 で無効。1pt = 1円 として精算で利用。
  pointRatePercent  Int       @default(0)
  // 特定商取引法に基づく表記（JSON TEXT）。販売事業者名・所在地・連絡先・返品条件 等。
  legalInfo         String?
  createdAt         DateTime  @default(now())
  deletedAt         DateTime?
  brand             Brand     @relation(fields: [brandId], references: [id])
  staffs            Staff[]
  customers         Customer[]
  appointments      Appointment[]
  visitSources      VisitSource[]
  equipments        Equipment[]
  cardColorPresets  CardColorPreset[]
  productCategories ProductCategory[]
  products          Product[]
  inventoryItems    InventoryItem[]
  stockMovements    StockMovement[]
  orders            Order[]
  pointTransactions PointTransaction[]
  productReviews    ProductReview[]
}

// 設備（楽トレ・水素吸引機 等）。スタッフの代わりにメニューの「リソース」として
// 予約される。複数台ある場合は同じ名前で複数行を作るのではなく、別名で管理する。
model Equipment {
  id           Int           @id @default(autoincrement())
  shopId       Int
  name         String
  color        String        @default("#a9803f")
  sortNumber   Int           @default(0)
  isBookable   Boolean       @default(true)
  createdAt    DateTime      @default(now())
  deletedAt    DateTime?
  shop         Shop          @relation(fields: [shopId], references: [id])
  menus        Menu[]
  appointments Appointment[]
}

model Staff {
  id            Int           @id @default(autoincrement())
  shopId        Int
  name          String
  color         String        @default("#6f9bd8")
  allocateOrder Int           @default(0)
  isBookable    Boolean       @default(true)
  // false = 常勤（毎日 営業時間どおり枠が出る）
  // true  = 臨時/スポット（workDates に入れた日だけ枠が出る）
  spotMode      Boolean       @default(false)
  // JSON (TEXT): 出勤日 ["2026-05-26","2026-05-28"]（spotMode のときのみ使用）
  workDates     String?
  createdAt     DateTime      @default(now())
  deletedAt     DateTime?
  shop          Shop          @relation(fields: [shopId], references: [id])
  appointments  Appointment[]
}

model Customer {
  id           Int           @id @default(autoincrement())
  shopId       Int
  // 外部システムの患者番号/会員番号など。店舗内で一意（再取込の重複防止キー）。
  code         String?
  name         String
  kana         String?
  phone        String?
  email        String?
  postalCode   String?
  address      String?
  // 自由記述（"男性"/"女性" など、取込元の表記をそのまま保持）
  gender       String?
  // 生年月日（日付のみ。UTC 0:00 として保存）
  birthday     DateTime?
  note         String?
  // 物販ポイント残高（PointTransaction の合計をキャッシュ）。1pt = 1円。
  pointsBalance Int          @default(0)
  createdAt    DateTime      @default(now())
  deletedAt    DateTime?
  shop         Shop          @relation(fields: [shopId], references: [id])
  appointments Appointment[]
  orders            Order[]
  pointTransactions PointTransaction[]

  @@unique([shopId, code])
}

// ---- Hybrid tables (shopId nullable -> NULL means brand-common) ----

model MenuCategory {
  id         Int       @id @default(autoincrement())
  shopId     Int?
  name       String
  sortNumber Int       @default(0)
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?
  menus      Menu[]
}

model Menu {
  id           Int           @id @default(autoincrement())
  shopId       Int?
  categoryId   Int?
  // VARCHAR prefix: BRD-xxx (brand-common) / STR-xxx (shop-only)
  menuManageId String        @unique
  name         String
  durationMin  Int           @default(60)
  price        Int           @default(0)
  isPublic     Boolean       @default(true)
  sortNumber   Int           @default(0)
  // メニュー実施に必要なリソース。スタッフ必須 + 設備指定の3パターン:
  //   ①スタッフのみ: requiresStaff=true, equipmentId=null (既存挙動)
  //   ②設備のみ:     requiresStaff=false, equipmentId=N (楽トレ・水素 等)
  //   ③両方:         requiresStaff=true, equipmentId=N
  requiresStaff Boolean      @default(true)
  equipmentId  Int?
  createdAt    DateTime      @default(now())
  deletedAt    DateTime?
  category     MenuCategory? @relation(fields: [categoryId], references: [id])
  equipment    Equipment?    @relation(fields: [equipmentId], references: [id])
  appointments Appointment[]
}

model VisitSource {
  id             Int           @id @default(autoincrement())
  shopId         Int
  name           String
  color          String        @default("#3a3119")
  labelTextColor String        @default("#d8b06a")
  sortNumber     Int           @default(0)
  createdAt      DateTime      @default(now())
  deletedAt      DateTime?
  shop           Shop          @relation(fields: [shopId], references: [id])
  appointments   Appointment[]
}

// 予約カードの背景色プリセット（店舗ごとに名前付きで色を保存）。
// 予約モーダルから「現在の色を保存」して、後で他の予約に再利用できる。
// Appointment.cardColor とは参照関係を持たず、選択時に hex 文字列を
// コピーする（プリセットを後から編集しても既存予約の色は変わらない）。
model CardColorPreset {
  id         Int      @id @default(autoincrement())
  shopId     Int
  name       String
  hexColor   String
  sortNumber Int      @default(0)
  createdAt  DateTime @default(now())
  deletedAt  DateTime?
  shop       Shop     @relation(fields: [shopId], references: [id])

  @@index([shopId])
}

model Appointment {
  id            Int          @id @default(autoincrement())
  shopId        Int
  customerId    Int?
  staffId       Int?
  menuId        Int?
  equipmentId   Int?
  visitSourceId Int?
  bookingLinkId Int?
  startAt       DateTime
  endAt         DateTime
  // 0 waiting / 1 in-service / 2 done / 3 cancel / 4 same-day cancel / 99 no-show
  status        Int          @default(0)
  sales         Int?
  note          String?
  // カードの背景色（手動で色分け）。未設定なら既定色を使う。
  cardColor     String?
  isMemberJoin  Boolean      @default(false)
  // manual | public
  source        String       @default("manual")
  // false = 確認連絡が未対応（主にオンライン予約）
  confirmed     Boolean      @default(true)
  // "appointment"（通常予約）/ "block"（予約以外の時間ブロック：休憩・会議・私用 等）
  kind          String       @default("appointment")
  blockLabel    String?
  guestName     String?
  guestPhone    String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?
  shop          Shop         @relation(fields: [shopId], references: [id])
  customer      Customer?    @relation(fields: [customerId], references: [id])
  staff         Staff?       @relation(fields: [staffId], references: [id])
  menu          Menu?        @relation(fields: [menuId], references: [id])
  equipment     Equipment?   @relation(fields: [equipmentId], references: [id])
  visitSource   VisitSource? @relation(fields: [visitSourceId], references: [id])
  bookingLink   BookingLink? @relation(fields: [bookingLinkId], references: [id])

  @@index([shopId, startAt])
  @@index([staffId, startAt])
  @@index([equipmentId, startAt])
}

// ---- Booking links (強制リンク) — brand-common, shopId NULL allowed ----

model BookingLink {
  id                    Int           @id @default(autoincrement())
  brandId               Int
  shopId                Int?
  slug                  String        @unique
  name                  String
  description           String?
  isActive              Boolean       @default(true)
  requireStaffSelection Boolean       @default(false)
  // 最終受付モード（旧）。現在は使われていない。allowOverflowAtBreak /
  // allowOverflowAtClose の組み合わせで置き換え済み。スキーマ互換のために残す。
  lastReceptionMode     Boolean       @default(false)
  // 施術が「休憩時間」にはみ出す予約を許可する（true で許可）。
  allowOverflowAtBreak  Boolean       @default(true)
  // 施術が「閉店時刻」をまたぐ予約を許可する（true で許可）。
  allowOverflowAtClose  Boolean       @default(true)
  // Slot interval shown on the public booking calendar. 15 / 30 / 60 minutes.
  intervalMin           Int           @default(30)
  // JSON (TEXT): array of allowed menu ids, e.g. "[1,2,3]"
  allowedMenuIds        String?
  // JSON (TEXT): reminder settings, e.g. {"enabled":true,"hoursBefore":24}
  reminderSettings      String?
  createdAt             DateTime      @default(now())
  deletedAt             DateTime?
  brand                 Brand         @relation(fields: [brandId], references: [id])
  appointments          Appointment[]
}

// ---- 物販（Retail / EC）— すべて店舗スコープ（shopId 必須）----

model ProductCategory {
  id         Int       @id @default(autoincrement())
  shopId     Int
  name       String
  sortNumber Int       @default(0)
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?
  shop       Shop      @relation(fields: [shopId], references: [id])
  products   Product[]

  @@index([shopId])
}

model Product {
  id          Int       @id @default(autoincrement())
  shopId      Int
  categoryId  Int?
  // 店舗内で一意の商品コード（任意）。再取込・棚卸の突合キー。
  sku         String?
  name        String
  description String?
  // 税抜価格（円）。表示・精算は税込で計算。
  price       Int       @default(0)
  // 原価（円）。粗利計算用。公開ページには出さない。
  cost        Int       @default(0)
  // 税率(%)。軽減税率対象は 8、標準は 10。
  taxRate     Int       @default(10)
  // JSON(TEXT): 画像URLの配列 ["https://..."]
  imageUrls   String?
  isPublic    Boolean   @default(true)
  sortNumber  Int       @default(0)
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?
  shop        Shop             @relation(fields: [shopId], references: [id])
  category    ProductCategory? @relation(fields: [categoryId], references: [id])
  inventory   InventoryItem?
  movements   StockMovement[]
  orderItems  OrderItem[]
  reviews     ProductReview[]

  @@unique([shopId, sku])
  @@index([shopId])
}

// 商品レビュー（星評価）。公開ページから投稿でき、管理者が非表示/削除できる。
model ProductReview {
  id          Int       @id @default(autoincrement())
  shopId      Int
  productId   Int
  authorName  String
  rating      Int       // 1..5
  title       String?
  comment     String?
  isPublished Boolean   @default(true)
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?
  shop        Shop      @relation(fields: [shopId], references: [id])
  product     Product   @relation(fields: [productId], references: [id])

  @@index([shopId, productId])
}

// 在庫（商品1件につき1行）。StockMovement の合計をキャッシュした現在数。
model InventoryItem {
  id          Int      @id @default(autoincrement())
  shopId      Int
  productId   Int      @unique
  quantity    Int      @default(0)
  // 発注点。quantity <= safetyStock で在庫アラート。
  safetyStock Int      @default(0)
  updatedAt   DateTime @updatedAt
  shop        Shop     @relation(fields: [shopId], references: [id])
  product     Product  @relation(fields: [productId], references: [id])

  @@index([shopId])
}

// 入出庫台帳（source of truth）。in 入荷 / out 販売 / waste 廃棄 / adjust 棚卸調整。
model StockMovement {
  id        Int      @id @default(autoincrement())
  shopId    Int
  productId Int
  type      String
  // 符号付き数量（+入荷・調整増 / -販売・廃棄・調整減）
  qty       Int
  reason    String?
  orderId   Int?
  createdAt DateTime @default(now())
  shop      Shop     @relation(fields: [shopId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])

  @@index([shopId, productId])
}

model Order {
  id              Int       @id @default(autoincrement())
  shopId          Int
  orderNo         String    @unique
  customerId      Int?
  // 購入者情報（顧客未紐付け時の連絡用 / 紐付けの突合に使用）
  buyerName       String
  buyerPhone      String?
  buyerEmail      String?
  // 会員番号（Customer.code との突合キー）
  buyerCode       String?
  // pickup 店頭受取 / shipping 配送
  fulfillment     String    @default("pickup")
  shippingAddress String?
  // pending 未決済 / paid 決済済 / cancelled / refunded
  paymentStatus   String    @default("pending")
  // received 受付 / preparing 準備中 / ready 受渡準備 / completed 完了 / cancelled
  status          String    @default("received")
  subtotal        Int       @default(0) // 税抜小計
  taxTotal        Int       @default(0)
  shippingFee     Int       @default(0)
  // ポイント利用（値引き）。現状の公開チェックアウトでは未使用（常に0）。
  // 将来ポイント充当を実装する際に total から差し引く。
  pointsUsed      Int       @default(0)
  pointsEarned    Int       @default(0)
  total           Int       @default(0) // 請求総額（税込商品合計 + 送料 - pointsUsed）
  note            String?
  stripeSessionId String?   @unique
  stripePaymentId String?
  paidAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  shop              Shop               @relation(fields: [shopId], references: [id])
  customer          Customer?          @relation(fields: [customerId], references: [id])
  items             OrderItem[]
  pointTransactions PointTransaction[]

  @@index([shopId, createdAt])
}

model OrderItem {
  id        Int      @id @default(autoincrement())
  orderId   Int
  productId Int?
  // 注文時点のスナップショット（商品が後で改名・削除されても明細は不変）
  name      String
  unitPrice Int      @default(0) // 税抜
  taxRate   Int      @default(10)
  qty       Int      @default(1)
  order     Order    @relation(fields: [orderId], references: [id])
  product   Product? @relation(fields: [productId], references: [id])

  @@index([orderId])
}

// ポイント台帳。earn 付与 / redeem 利用 / adjust 手動調整。
model PointTransaction {
  id         Int      @id @default(autoincrement())
  shopId     Int
  customerId Int
  orderId    Int?
  type       String
  points     Int      // 符号付き（+付与 / -利用）
  reason     String?
  createdAt  DateTime @default(now())
  shop       Shop      @relation(fields: [shopId], references: [id])
  customer   Customer  @relation(fields: [customerId], references: [id])
  order      Order?    @relation(fields: [orderId], references: [id])

  @@index([shopId, customerId])
}
