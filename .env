# DATABASE_URL is NOT set here on purpose — it must point to a hosted
# PostgreSQL database and is provided as an environment variable on Vercel
# (Project → Settings → Environment Variables). For local dev, put it in
# .env.local (gitignored), e.g.:
#   DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# Dev fallback secret for signing the session cookie. Override in Vercel
# (and .env.local) with a long random string for real security.
AUTH_SECRET="beau-dev-secret-change-me-in-production-0c1f"
